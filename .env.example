# Owli 凭证文件
# 复制到 ~/.owli/.env —— 注意不是仓库根目录的 .env，采集源只读这个路径，不读 shell 环境变量
#   mkdir -p ~/.owli && cp .env.example ~/.owli/.env

# ── 国内社媒 ──
TIKHUB_API_KEY=            # 小红书、抖音

# ── 海外 ──
PROWLO_API_KEY=            # Reddit 主通道
APIFY_TOKEN=               # Reddit 兜底（可选）
X_BEARER_TOKEN=            # X / Twitter
PRODUCT_HUNT_TOKEN=        # Product Hunt（Hacker News 不需要 key）

# ── 网页搜索（EXA / TAVILY 至少配一个）──
EXA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=            # Google，默认关；OWLI_WEB_SEARCH_GOOGLE=1 才用

# ── Codex API key 模式（默认走订阅登录，不用填）──
OPENAI_API_KEY=

# ── 飞书导出（可选，另需安装 lark-cli）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=

# ── 微博 / 公众号 ──
# 这两个源不是配 key 就能用：它们读 ~/.owli/precollect/ 下的离线预采集数据，
# 需要先用 MediaCrawler 或影刀在本机采好（公众号还要人在场处理登录和验证码）。
# 没有这批数据时，这两个源会返回空。
